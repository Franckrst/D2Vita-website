{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Franckrst/D2Vita-website/main/contract/schemas/admin.v1.schema.json",
  "title": "D2Vita admin API, v1",
  "description": "Definitions only: validate against #/$defs/<Name>. Admin routes (Authorization: Bearer <token>) and ErrorBody, the error body of every route (console, site and admin). See contract/README.md for the route to definition map.",
  "$defs": {
    "Count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "Sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "InstallHash": {
      "description": "HMAC-SHA256(INSTALL_HASH_KEY, install_id) as lowercase hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Version": {
      "description": "The VERSION part of a build_id.",
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "HttpsUrl": { "type": "string", "maxLength": 300, "pattern": "^https://[!-~]+$" },
    "Note": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$"
    },
    "Cursor": {
      "description": "Opaque pagination cursor, passed back as ?cursor=.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,256}$"
    },
    "SignatureStatus": {
      "description": "regressed is set by the server only.",
      "enum": ["open", "fixed", "ignored", "regressed"]
    },
    "SampleState": { "enum": ["none", "leased", "stored"] },
    "Canon": {
      "description": "Canonical string the signature id is derived from (contract/signature-rules.v1.md).",
      "type": "string",
      "pattern": "^[!-~]{1,512}$"
    },
    "StoredArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256", "stored_unix"],
      "properties": {
        "name": { "$ref": "claim.v1.schema.json#/$defs/ArtifactName" },
        "bytes": { "$ref": "#/$defs/Count" },
        "sha256": {
          "description": "SHA-256 of the sealed bytes as stored.",
          "$ref": "#/$defs/Sha256Hex"
        },
        "stored_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" }
      }
    },
    "SignatureSummary": {
      "description": "Item of GET /v1/admin/signatures.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "canon", "status", "count", "installs", "first_seen_unix", "last_seen_unix",
        "sample_state", "fixed_in_version", "merged_into", "issue_url"
      ],
      "properties": {
        "id": { "$ref": "decision.v1.schema.json#/$defs/SignatureId" },
        "kind": { "$ref": "claim.v1.schema.json#/$defs/Kind" },
        "canon": { "$ref": "#/$defs/Canon" },
        "status": { "$ref": "#/$defs/SignatureStatus" },
        "count": { "$ref": "#/$defs/Count" },
        "installs": { "description": "Distinct installations.", "$ref": "#/$defs/Count" },
        "first_seen_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" },
        "last_seen_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" },
        "sample_state": { "$ref": "#/$defs/SampleState" },
        "fixed_in_version": { "anyOf": [{ "$ref": "#/$defs/Version" }, { "type": "null" }] },
        "merged_into": {
          "anyOf": [{ "$ref": "decision.v1.schema.json#/$defs/SignatureId" }, { "type": "null" }]
        },
        "issue_url": { "anyOf": [{ "$ref": "#/$defs/HttpsUrl" }, { "type": "null" }] }
      }
    },
    "SignatureList": {
      "description": "Response of GET /v1/admin/signatures?status=&kind=&build=&sort=count|last_seen&cursor=.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "items", "next_cursor"],
      "properties": {
        "v": { "const": 1 },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/SignatureSummary" } },
        "next_cursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] }
      }
    },
    "SignatureDetail": {
      "description": "Response of GET and PATCH /v1/admin/signatures/{id}. Repeats every SignatureSummary field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v", "id", "kind", "canon", "status", "count", "installs", "first_seen_unix", "last_seen_unix",
        "sample_state", "fixed_in_version", "merged_into", "issue_url", "rules_version", "note",
        "sample_report", "lease_report", "lease_expires_unix", "sample_artifacts", "builds", "recent_reports"
      ],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "decision.v1.schema.json#/$defs/SignatureId" },
        "kind": { "$ref": "claim.v1.schema.json#/$defs/Kind" },
        "canon": { "$ref": "#/$defs/Canon" },
        "status": { "$ref": "#/$defs/SignatureStatus" },
        "count": { "$ref": "#/$defs/Count" },
        "installs": { "description": "Distinct installations.", "$ref": "#/$defs/Count" },
        "first_seen_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" },
        "last_seen_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" },
        "sample_state": { "$ref": "#/$defs/SampleState" },
        "fixed_in_version": { "anyOf": [{ "$ref": "#/$defs/Version" }, { "type": "null" }] },
        "merged_into": {
          "anyOf": [{ "$ref": "decision.v1.schema.json#/$defs/SignatureId" }, { "type": "null" }]
        },
        "issue_url": { "anyOf": [{ "$ref": "#/$defs/HttpsUrl" }, { "type": "null" }] },
        "rules_version": { "type": "integer", "minimum": 1 },
        "note": { "anyOf": [{ "$ref": "#/$defs/Note" }, { "type": "null" }] },
        "sample_report": {
          "anyOf": [{ "$ref": "claim.v1.schema.json#/$defs/ReportId" }, { "type": "null" }]
        },
        "lease_report": {
          "anyOf": [{ "$ref": "claim.v1.schema.json#/$defs/ReportId" }, { "type": "null" }]
        },
        "lease_expires_unix": {
          "anyOf": [{ "$ref": "claim.v1.schema.json#/$defs/U32" }, { "type": "null" }]
        },
        "sample_artifacts": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/StoredArtifact" }
        },
        "builds": {
          "description": "Counters per build.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["build_id", "count", "first_seen_unix", "last_seen_unix"],
            "properties": {
              "build_id": { "$ref": "claim.v1.schema.json#/$defs/BuildId" },
              "count": { "$ref": "#/$defs/Count" },
              "first_seen_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" },
              "last_seen_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" }
            }
          }
        },
        "recent_reports": {
          "description": "Most recent claims first.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["report_id", "build_id", "received_unix", "action"],
            "properties": {
              "report_id": { "$ref": "claim.v1.schema.json#/$defs/ReportId" },
              "build_id": { "$ref": "claim.v1.schema.json#/$defs/BuildId" },
              "received_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" },
              "action": { "$ref": "decision.v1.schema.json#/$defs/Action" }
            }
          }
        }
      }
    },
    "SignaturePatch": {
      "description": "Body of PATCH /v1/admin/signatures/{id}. resample: true asks for a new sample.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "status": { "enum": ["open", "fixed", "ignored"] },
        "fixed_in_version": { "anyOf": [{ "$ref": "#/$defs/Version" }, { "type": "null" }] },
        "merged_into": {
          "anyOf": [{ "$ref": "decision.v1.schema.json#/$defs/SignatureId" }, { "type": "null" }]
        },
        "issue_url": { "anyOf": [{ "$ref": "#/$defs/HttpsUrl" }, { "type": "null" }] },
        "note": { "anyOf": [{ "$ref": "#/$defs/Note" }, { "type": "null" }] },
        "resample": { "type": "boolean" }
      }
    },
    "ReportDetail": {
      "description": "Response of GET /v1/admin/reports/{report_id}: the stored claim and what happened to it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v", "report_id", "signature", "install_hash", "received_unix", "rules_version", "action",
        "completed_unix", "claim", "artifacts"
      ],
      "properties": {
        "v": { "const": 1 },
        "report_id": { "$ref": "claim.v1.schema.json#/$defs/ReportId" },
        "signature": { "$ref": "decision.v1.schema.json#/$defs/SignatureId" },
        "install_hash": { "$ref": "#/$defs/InstallHash" },
        "received_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" },
        "rules_version": { "type": "integer", "minimum": 1 },
        "action": { "$ref": "decision.v1.schema.json#/$defs/Action" },
        "completed_unix": {
          "anyOf": [{ "$ref": "claim.v1.schema.json#/$defs/U32" }, { "type": "null" }]
        },
        "claim": { "$ref": "claim.v1.schema.json" },
        "artifacts": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/StoredArtifact" }
        }
      }
    },
    "BugStatus": { "enum": ["open", "fixed", "ignored"] },
    "BugItem": {
      "description": "Item of GET /v1/admin/bugs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "description", "version", "contact", "lang", "status", "issue_url", "created_unix"
      ],
      "properties": {
        "id": { "$ref": "bug.v1.schema.json#/$defs/BugId" },
        "title": { "$ref": "bug.v1.schema.json#/properties/title" },
        "description": { "$ref": "bug.v1.schema.json#/properties/description" },
        "version": { "$ref": "bug.v1.schema.json#/properties/version" },
        "contact": { "anyOf": [{ "$ref": "bug.v1.schema.json#/properties/contact" }, { "type": "null" }] },
        "lang": { "$ref": "bug.v1.schema.json#/properties/lang" },
        "status": { "$ref": "#/$defs/BugStatus" },
        "issue_url": { "anyOf": [{ "$ref": "#/$defs/HttpsUrl" }, { "type": "null" }] },
        "created_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" }
      }
    },
    "BugList": {
      "description": "Response of GET /v1/admin/bugs?status=&cursor=.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "items", "next_cursor"],
      "properties": {
        "v": { "const": 1 },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/BugItem" } },
        "next_cursor": { "anyOf": [{ "$ref": "#/$defs/Cursor" }, { "type": "null" }] }
      }
    },
    "BugDetail": {
      "description": "Response of GET and PATCH /v1/admin/bugs/{id}: v plus every BugItem field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v", "id", "title", "description", "version", "contact", "lang", "status", "issue_url", "created_unix"
      ],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "bug.v1.schema.json#/$defs/BugId" },
        "title": { "$ref": "bug.v1.schema.json#/properties/title" },
        "description": { "$ref": "bug.v1.schema.json#/properties/description" },
        "version": { "$ref": "bug.v1.schema.json#/properties/version" },
        "contact": { "anyOf": [{ "$ref": "bug.v1.schema.json#/properties/contact" }, { "type": "null" }] },
        "lang": { "$ref": "bug.v1.schema.json#/properties/lang" },
        "status": { "$ref": "#/$defs/BugStatus" },
        "issue_url": { "anyOf": [{ "$ref": "#/$defs/HttpsUrl" }, { "type": "null" }] },
        "created_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" }
      }
    },
    "BugPatch": {
      "description": "Body of PATCH /v1/admin/bugs/{id}.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "status": { "$ref": "#/$defs/BugStatus" },
        "issue_url": { "anyOf": [{ "$ref": "#/$defs/HttpsUrl" }, { "type": "null" }] }
      }
    },
    "BuildRegistration": {
      "description": "Body of POST /v1/admin/builds. version must equal the VERSION part of build_id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "version", "channel"],
      "properties": {
        "build_id": { "$ref": "claim.v1.schema.json#/$defs/BuildId" },
        "version": { "$ref": "#/$defs/Version" },
        "channel": { "$ref": "claim.v1.schema.json#/$defs/Channel" }
      }
    },
    "BuildRecord": {
      "description": "Response of POST /v1/admin/builds (201 when created, 200 when already registered).",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "build_id", "version", "channel", "registered_unix"],
      "properties": {
        "v": { "const": 1 },
        "build_id": { "$ref": "claim.v1.schema.json#/$defs/BuildId" },
        "version": { "$ref": "#/$defs/Version" },
        "channel": { "$ref": "claim.v1.schema.json#/$defs/Channel" },
        "registered_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "cap"],
      "properties": {
        "used": { "$ref": "#/$defs/Count" },
        "cap": { "$ref": "#/$defs/Count" }
      }
    },
    "Stats": {
      "description": "Response of GET /v1/admin/stats: global quota consumption for the current UTC day.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "day", "accepting", "usage"],
      "properties": {
        "v": { "const": 1 },
        "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "accepting": { "type": "boolean" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claims", "artifact_bytes", "new_signatures", "bugs"],
          "properties": {
            "claims": { "$ref": "#/$defs/Usage" },
            "artifact_bytes": { "$ref": "#/$defs/Usage" },
            "new_signatures": { "$ref": "#/$defs/Usage" },
            "bugs": { "$ref": "#/$defs/Usage" }
          }
        }
      }
    },
    "CapName": {
      "description": "Daily caps of design section 5.5. prerelease_* apply to dev and test builds.",
      "enum": [
        "install_claims_per_day",
        "install_artifact_bytes_per_day",
        "prerelease_install_claims_per_day",
        "prerelease_install_artifact_bytes_per_day",
        "ip_claims_per_day",
        "ip_bugs_per_day",
        "global_claims_per_day",
        "global_artifact_bytes_per_day",
        "global_new_signatures_per_day",
        "global_bugs_per_day"
      ]
    },
    "Settings": {
      "description": "Response of GET and PUT /v1/admin/settings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "accepting", "disable_until_unix", "caps"],
      "properties": {
        "v": { "const": 1 },
        "accepting": { "description": "Kill switch: false makes claims answer 503 not_accepting.", "type": "boolean" },
        "disable_until_unix": { "anyOf": [{ "$ref": "claim.v1.schema.json#/$defs/U32" }, { "type": "null" }] },
        "caps": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Count" },
          "propertyNames": { "$ref": "#/$defs/CapName" },
          "required": [
            "install_claims_per_day",
            "install_artifact_bytes_per_day",
            "prerelease_install_claims_per_day",
            "prerelease_install_artifact_bytes_per_day",
            "ip_claims_per_day",
            "ip_bugs_per_day",
            "global_claims_per_day",
            "global_artifact_bytes_per_day",
            "global_new_signatures_per_day",
            "global_bugs_per_day"
          ]
        }
      }
    },
    "SettingsUpdate": {
      "description": "Body of PUT /v1/admin/settings: only the given fields change.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "accepting": { "type": "boolean" },
        "disable_until_unix": { "anyOf": [{ "$ref": "claim.v1.schema.json#/$defs/U32" }, { "type": "null" }] },
        "caps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/Count" },
          "propertyNames": { "$ref": "#/$defs/CapName" }
        }
      }
    },
    "ForgetInstallResult": {
      "description": "Response of DELETE /v1/admin/installs/{install_id}.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "reports_deleted", "artifacts_deleted"],
      "properties": {
        "v": { "const": 1 },
        "reports_deleted": { "$ref": "#/$defs/Count" },
        "artifacts_deleted": { "$ref": "#/$defs/Count" }
      }
    },
    "ErrorBody": {
      "description": "Body of every 4xx/5xx response. Responses to console endpoints are signed like the others. See contract/README.md for the status of each code.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "error", "message"],
      "properties": {
        "v": { "const": 1 },
        "error": {
          "enum": [
            "invalid_payload",
            "unauthorized",
            "unknown_build",
            "bad_token",
            "turnstile",
            "not_found",
            "method_not_allowed",
            "exists",
            "incomplete",
            "payload_too_large",
            "rate_limited",
            "internal_error",
            "not_accepting"
          ]
        },
        "message": { "type": "string", "maxLength": 500 },
        "retry_after_s": { "$ref": "claim.v1.schema.json#/$defs/U32" },
        "disable_until_unix": { "$ref": "claim.v1.schema.json#/$defs/U32" }
      },
      "allOf": [
        {
          "if": { "required": ["error"], "properties": { "error": { "const": "rate_limited" } } },
          "then": { "required": ["retry_after_s"] }
        },
        {
          "if": { "required": ["error"], "properties": { "error": { "const": "not_accepting" } } },
          "then": { "required": ["disable_until_unix"] }
        }
      ]
    }
  }
}
