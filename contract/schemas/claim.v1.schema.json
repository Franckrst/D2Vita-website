{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Franckrst/D2Vita-website/main/contract/schemas/claim.v1.schema.json",
  "title": "D2Vita crash claim, v1",
  "description": "Body of POST /v1/claims, sent by the console after the player consented. At most 16384 bytes of UTF-8 JSON (enforced by the transport, not by this schema). The signature of a claim is computed from its fields as described in contract/signature-rules.v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "report_id",
    "install_id",
    "build_id",
    "channel",
    "platform",
    "session",
    "kind",
    "features",
    "hints",
    "artifacts"
  ],
  "properties": {
    "v": { "const": 1 },
    "report_id": { "$ref": "#/$defs/ReportId" },
    "install_id": { "$ref": "#/$defs/InstallId" },
    "build_id": { "$ref": "#/$defs/BuildId" },
    "channel": { "$ref": "#/$defs/Channel" },
    "platform": {
      "description": "Best effort: \"unknown\" when the application cannot read the value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "fw"],
      "properties": {
        "model": { "enum": ["vita", "pstv", "unknown"] },
        "fw": { "type": "string", "pattern": "^([0-9]{1,2}\\.[0-9]{2}|unknown)$" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_unix", "uptime_s", "online"],
      "properties": {
        "started_unix": { "$ref": "#/$defs/U32" },
        "uptime_s": {
          "description": "Seconds between the start of the crashed session and the crash; null when unknown.",
          "anyOf": [{ "$ref": "#/$defs/U32" }, { "type": "null" }]
        },
        "online": { "type": "boolean" }
      }
    },
    "kind": { "$ref": "#/$defs/Kind" },
    "features": {
      "description": "Shape depends on kind, see the allOf branches below.",
      "type": "object"
    },
    "hints": {
      "description": "Other kinds of evidence found for the same run. Each hint is strictly less severe than kind (host_fault > halt > abnormal_exit > guest_fault > hang).",
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Kind" }
    },
    "artifacts": {
      "description": "Artifacts the console holds for this report. At most one entry per name. Only a host_fault claim whose features.redaction is clean may offer the dump (design section 4.5): other kinds have no dump, and a withheld dump is never offered.",
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/ArtifactOffer" },
      "$ref": "#/$defs/OneEntryPerArtifactName"
    },
    "redactions": {
      "description": "Number of secret occurrences replaced in the artifacts (section 4.6 of the design). Never the values.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "halt" } } },
      "then": {
        "type": "object",
        "properties": {
          "features": { "$ref": "#/$defs/HaltFeatures" },
          "hints": { "type": "array", "items": { "enum": ["abnormal_exit", "guest_fault", "hang"] } },
          "artifacts": { "$ref": "#/$defs/ArtifactsWithoutDump" }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "guest_fault" } } },
      "then": {
        "type": "object",
        "properties": {
          "features": { "$ref": "#/$defs/GuestFaultFeatures" },
          "hints": { "type": "array", "items": { "enum": ["hang"] } },
          "artifacts": { "$ref": "#/$defs/ArtifactsWithoutDump" }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "host_fault" } } },
      "then": {
        "type": "object",
        "properties": {
          "features": { "$ref": "#/$defs/HostFaultFeatures" },
          "hints": { "type": "array", "items": { "enum": ["halt", "abnormal_exit", "guest_fault", "hang"] } }
        },
        "if": {
          "type": "object",
          "required": ["features"],
          "properties": {
            "features": { "type": "object", "required": ["redaction"], "properties": { "redaction": { "const": "withheld" } } }
          }
        },
        "then": {
          "type": "object",
          "properties": { "artifacts": { "$ref": "#/$defs/ArtifactsWithoutDump" } }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "abnormal_exit" } } },
      "then": {
        "type": "object",
        "properties": {
          "features": { "$ref": "#/$defs/AbnormalExitFeatures" },
          "hints": { "type": "array", "items": { "enum": ["guest_fault", "hang"] } },
          "artifacts": { "$ref": "#/$defs/ArtifactsWithoutDump" }
        }
      }
    },
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "hang" } } },
      "then": {
        "type": "object",
        "properties": {
          "features": { "$ref": "#/$defs/HangFeatures" },
          "hints": { "type": "array", "maxItems": 0 },
          "artifacts": { "$ref": "#/$defs/ArtifactsWithoutDump" }
        }
      }
    }
  ],
  "$defs": {
    "U32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "ReportId": {
      "description": "ULID: 26 characters of uppercase Crockford base32; the first character is 0-7 (128-bit value).",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "InstallId": {
      "description": "128 random bits created on first launch, as 32 lowercase hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "BuildId": {
      "description": "<VERSION>+<12 lowercase hex digits of the commit>[-dirty].",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9a-f]{12}(-dirty)?$"
    },
    "Channel": { "enum": ["release", "dev", "test"] },
    "Kind": { "enum": ["halt", "guest_fault", "host_fault", "abnormal_exit", "hang"] },
    "ArtifactName": { "enum": ["dump", "crash_txt", "crash_log", "boot_progress"] },
    "Hex32": {
      "description": "A 32-bit value as 0x followed by lowercase hex digits without leading zeros (0x0 for zero).",
      "type": "string",
      "pattern": "^0x(0|[1-9a-f][0-9a-f]{0,7})$"
    },
    "ModuleName": {
      "description": "Name of a system module exactly as the dump's module list gives it, e.g. SceLibKernel.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.]{1,32}$"
    },
    "Address": {
      "description": "Guest (x86) address <module>+0x<offset>, offset in lowercase hex without leading zeros. module is Game for Game.exe, the lowercase file name without extension for another image mapped by the guest (glide3x, checkrevision), or ABS for an address in no mapped image, whose offset is then the address itself. See Module names in contract/signature-rules.v1.md.",
      "type": "string",
      "pattern": "^(Game|ABS|(?!(game|abs)\\+)[a-z0-9_]{1,32})\\+0x(0|[1-9a-f][0-9a-f]{0,7})$"
    },
    "HostAddress": {
      "description": "Host (ARM) address split by region. module is the region name for eboot, jit and unknown, and the system module name for sysmodule. offset is relative to the start of the eboot, of the translation cache or of the system module; for unknown it is the address itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "module", "offset"],
      "properties": {
        "region": { "enum": ["eboot", "jit", "sysmodule", "unknown"] },
        "module": { "$ref": "#/$defs/ModuleName" },
        "offset": { "$ref": "#/$defs/Hex32" }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["region"], "properties": { "region": { "const": "eboot" } } },
          "then": { "type": "object", "properties": { "module": { "const": "eboot" } } }
        },
        {
          "if": { "type": "object", "required": ["region"], "properties": { "region": { "const": "jit" } } },
          "then": { "type": "object", "properties": { "module": { "const": "jit" } } }
        },
        {
          "if": { "type": "object", "required": ["region"], "properties": { "region": { "const": "unknown" } } },
          "then": { "type": "object", "properties": { "module": { "const": "unknown" } } }
        }
      ]
    },
    "SourceLocation": {
      "description": "<file basename>:<line>, e.g. Codec.cpp:1377.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}:(0|[1-9][0-9]{0,9})$"
    },
    "Frames16": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/Address" }
    },
    "ArtifactOffer": {
      "description": "bytes is the exact size of the sealed D2VSEAL1 object the console would upload (the Content-Length of its PUT), so at least 88 and at most the per-artifact cap.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes"],
      "properties": {
        "name": { "$ref": "#/$defs/ArtifactName" },
        "bytes": { "type": "integer", "minimum": 88 }
      },
      "allOf": [
        { "$ref": "#/$defs/ArtifactSizeCaps" }
      ]
    },
    "OneEntryPerArtifactName": {
      "description": "An array of {name, ...} objects where each artifact name appears at most once.",
      "allOf": [
        {
          "type": "array",
          "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "dump" } } },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "type": "array",
          "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "crash_txt" } } },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "type": "array",
          "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "crash_log" } } },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "type": "array",
          "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "boot_progress" } } },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "ArtifactsWithoutDump": {
      "description": "An artifact list with no entry named dump.",
      "type": "array",
      "not": {
        "type": "array",
        "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "dump" } } }
      }
    },
    "ArtifactSizeCaps": {
      "description": "Sealed size caps from section 4.5 of the design: dump 2 MiB, crash_txt 64 KiB, crash_log 64 KiB, boot_progress 320 KiB. Applies to the bytes (claim) or max_bytes (decision) property.",
      "allOf": [
        {
          "if": { "type": "object", "required": ["name"], "properties": { "name": { "const": "dump" } } },
          "then": { "type": "object", "properties": { "bytes": { "type": "integer", "maximum": 2097152 }, "max_bytes": { "type": "integer", "maximum": 2097152 } } }
        },
        {
          "if": { "type": "object", "required": ["name"], "properties": { "name": { "const": "crash_txt" } } },
          "then": { "type": "object", "properties": { "bytes": { "type": "integer", "maximum": 65536 }, "max_bytes": { "type": "integer", "maximum": 65536 } } }
        },
        {
          "if": { "type": "object", "required": ["name"], "properties": { "name": { "const": "crash_log" } } },
          "then": { "type": "object", "properties": { "bytes": { "type": "integer", "maximum": 65536 }, "max_bytes": { "type": "integer", "maximum": 65536 } } }
        },
        {
          "if": { "type": "object", "required": ["name"], "properties": { "name": { "const": "boot_progress" } } },
          "then": { "type": "object", "properties": { "bytes": { "type": "integer", "maximum": 327680 }, "max_bytes": { "type": "integer", "maximum": 327680 } } }
        }
      ]
    },
    "HaltFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "location", "frames"],
      "properties": {
        "code": { "$ref": "#/$defs/U32" },
        "location": { "anyOf": [{ "$ref": "#/$defs/SourceLocation" }, { "type": "null" }] },
        "frames": {
          "description": "Guest call frames, innermost first, Fog reporter frames removed.",
          "$ref": "#/$defs/Frames16"
        }
      }
    },
    "GuestFaultFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception", "thread", "eip", "frames"],
      "properties": {
        "exception": {
          "description": "Win32 exception code of the guest fault, or null when unknown.",
          "anyOf": [{ "$ref": "#/$defs/Hex32" }, { "type": "null" }]
        },
        "thread": { "enum": ["main", "worker"] },
        "eip": { "$ref": "#/$defs/Address" },
        "frames": { "$ref": "#/$defs/Frames16" }
      }
    },
    "HostFaultFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_reason", "thread_name", "pc", "lr", "guest_frames", "redaction"],
      "properties": {
        "stop_reason": {
          "description": "Stop reason code of the faulting thread (THREAD_INFO note of the psp2dmp), or null when unreadable.",
          "anyOf": [{ "$ref": "#/$defs/Hex32" }, { "type": "null" }]
        },
        "thread_name": {
          "anyOf": [{ "type": "string", "pattern": "^[ -~]{0,32}$" }, { "type": "null" }]
        },
        "pc": { "$ref": "#/$defs/HostAddress" },
        "lr": { "$ref": "#/$defs/HostAddress" },
        "guest_frames": {
          "description": "Guest EBP chain read from the dump, innermost first.",
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Address" }
        },
        "redaction": {
          "description": "withheld: a secret was found in the dump, so the dump is not offered.",
          "enum": ["clean", "withheld"]
        }
      }
    },
    "AbnormalExitFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "code", "import", "frames"],
      "properties": {
        "reason": {
          "description": "main_thread_fault, unshimmed_import, fatal_app_exit, raise_exception, exit_process (non-zero exit code).",
          "enum": ["main_thread_fault", "unshimmed_import", "fatal_app_exit", "raise_exception", "exit_process"]
        },
        "code": {
          "description": "Exit or exception code, or null.",
          "anyOf": [{ "$ref": "#/$defs/U32" }, { "type": "null" }]
        },
        "import": {
          "description": "Name of the unshimmed import, or null.",
          "anyOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_.!@?$#]{1,128}$" }, { "type": "null" }]
        },
        "frames": { "$ref": "#/$defs/Frames16" }
      }
    },
    "HangFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stalled_beats", "eip", "runner_state"],
      "properties": {
        "stalled_beats": {
          "description": "Final alive: beats without frame progress.",
          "type": "integer",
          "minimum": 2,
          "maximum": 1000000
        },
        "eip": { "anyOf": [{ "$ref": "#/$defs/Address" }, { "type": "null" }] },
        "runner_state": {
          "anyOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,32}$" }, { "type": "null" }]
        }
      }
    }
  }
}
