{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Franckrst/D2Vita-website/main/contract/schemas/bug.v1.schema.json",
  "title": "D2Vita bug report, v1",
  "description": "Body of POST /v1/bugs, sent by the public site. String lengths count Unicode code points. $defs/BugCreated is the body of the 201 response.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "version", "lang", "turnstile_token"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "description": {
      "description": "Free text; tab, line feed and carriage return are the only control characters allowed.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "contact": {
      "description": "Optional. An absent field and an empty string both mean no contact.",
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "lang": { "enum": ["fr", "en"] },
    "turnstile_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[!-~]+$"
    }
  },
  "$defs": {
    "BugId": {
      "description": "\"B\" followed by 8 to 31 uppercase letters or digits.",
      "type": "string",
      "pattern": "^B[0-9A-Z]{8,31}$"
    },
    "BugCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/BugId" }
      }
    }
  }
}
